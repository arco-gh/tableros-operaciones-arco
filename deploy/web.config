<?xml version="1.0" encoding="UTF-8"?>
<!--
  Proxy inverso en IIS (Windows Server).

  Requisitos previos en el servidor:
    1. Instalar "URL Rewrite" y "Application Request Routing" (ARR).
    2. En IIS Manager > nodo del servidor > Application Request Routing Cache >
       Server Proxy Settings: marcar "Enable proxy".
    3. Crear un sitio (o aplicación) apuntando a una carpeta vacía y colocar
       este web.config dentro.

  Sin la regla de WebSocket el tablero carga pero se queda en "Connecting..."
  y no responde a los filtros.
-->
<configuration>
  <system.webServer>

    <webSocket enabled="true" pingInterval="00:00:30" />

    <rewrite>
      <rules>
        <rule name="Streamlit WebSocket" stopProcessing="true">
          <match url="^_stcore/stream" />
          <action type="Rewrite" url="http://127.0.0.1:8501/{R:0}" />
        </rule>

        <rule name="Streamlit HTTP" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8501/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <!-- Información financiera interna: no indexar, no embeber. -->
        <add name="X-Robots-Tag" value="noindex, nofollow" />
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>
